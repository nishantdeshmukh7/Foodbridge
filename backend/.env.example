# ============================================================
# FoodBridge Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Database (REQUIRED)
# ----------------------------------------------------------
# PostgreSQL connection string.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/foodbridge?schema=public

# ----------------------------------------------------------
# JWT Authentication (REQUIRED)
# ----------------------------------------------------------
# Generate a strong secret — the server will refuse to start without this.
# Suggested command:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<generate-your-own-secret>

# How long tokens stay valid. Examples: 7d, 1d, 24h
JWT_EXPIRES_IN=7d

# ----------------------------------------------------------
# CORS (REQUIRED in production, optional in development)
# ----------------------------------------------------------
# Set to the exact URL where your frontend is served.
# In production this MUST be set or the server will refuse to start.
# In development it defaults to http://localhost:8080 if omitted.
FRONTEND_URL=http://localhost:8080

# ----------------------------------------------------------
# Server (optional)
# ----------------------------------------------------------
PORT=3001
NODE_ENV=development
