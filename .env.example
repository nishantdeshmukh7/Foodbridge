# ============================================================
# FoodBridge Frontend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Backend API URL (REQUIRED — must be set BEFORE building)
# ----------------------------------------------------------
# Vite bakes this value into the static bundle at build time.
# For local development, point at the backend dev server.
# For Render deployment, set to your backend Web Service URL.
#
# Local development:
VITE_API_URL=http://localhost:3001/api
#
# Production example (replace with your actual Render URL):
# VITE_API_URL=https://foodbridge-backend.onrender.com/api
