*.tgz

# Docker Volumes
postgres_data/
prometheus_data/
grafana_data/

# Phase 26: database backups. A pg_dump archive contains every user's
# data, including password hashes and password-reset token hashes - it
# must never be committed, regardless of where it's produced. *.dump is
# belt-and-suspenders in case one ever ends up outside these directories.
backups/
backend/backups/
*.dump
